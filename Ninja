-- Close Button Logic
CloseButton.MouseButton1Click:Connect(function()
    Frame.Visible = false
    OpenButton.Visible = true
end)

-- Open Button Logic
OpenButton.MouseButton1Click:Connect(function()
    Frame.Visible = true
    OpenButton.Visible = false
end)

-- Stamina Button Logic
StaminaButton.MouseButton1Click:Connect(function()
    local Sprinting = game:GetService("ReplicatedStorage").Systems.Character.Game.Sprinting
    local stamina = require(Sprinting)
    stamina.MaxStamina = 100  -- Maximum stamina
    stamina.MinStamina = -20  -- Minimum stamina
    stamina.StaminaGain = 100 -- Stamina gain
    stamina.StaminaLoss = 0 -- Stamina loss
    stamina.SprintSpeed = 40 -- Sprint speed
    stamina.StaminaLossDisabled = true -- Disable stamina drain (true/false)
end)

-- Range TextBox Logic
RangeTextBox.FocusLost:Connect(function(enterPressed)
    local input = RangeTextBox.Text
    if tonumber(input) then
        aimRadius = tonumber(input)
        ErrorLabel.Text = ""
    else
        ErrorLabel.Text = "Error: Not a valid number!"
        RangeTextBox.Text = tostring(aimRadius) -- Reset to previous valid value
    end
end)

-- Prediction TextBox Logic
PredictionTextBox.FocusLost:Connect(function(enterPressed)
    local input = PredictionTextBox.Text
    if tonumber(input) then
        predictionStrength = tonumber(input)
        ErrorLabel.Text = ""
    else
        ErrorLabel.Text = "Error: Not a valid number!"
        PredictionTextBox.Text = tostring(predictionStrength) -- Reset to previous valid value
    end
end)
